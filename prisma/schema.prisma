// 한판 데이터 모델
//
// 화면이 쓰는 lib/types.ts 와 1:1로 맞춘다.
// 여기서 이름이 어긋나면 화면까지 줄줄이 손봐야 하므로 일부러 똑같이 둔다.
//
// 원칙
// - 프로필 사진은 서버에 파일로 두고 주소만 담는다. 검수를 통과한 것만 노출한다.
// - 개인 연락처는 저장하되 상대에게 노출하지 않는다. 대화는 앱 안에서만.
// - 관리자 비밀번호는 원문을 담지 않는다. 해시만 담는다.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7부터 접속 URL은 스키마가 아니라 prisma.config.ts 에서 지정한다.
datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum PhotoStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ListingKind {
  TEACH // 알려드려요
  LEARN // 알려주세요
  PLAY // 같이해요
}

enum MeetMode {
  ONLINE
  OFFLINE
  BOTH
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SettlementStatus {
  PENDING
  PAID
}

enum PlanTarget {
  MEMBER
  MATE
  PCBANG
}

model User {
  id       String @id
  nickname String

  /// 휴대폰 번호. 숫자만 남긴 형태를 따로 두어 중복 가입을 막는다.
  phone      String
  phoneDigits String @unique
  verified   Boolean @default(false)

  role      Role      @default(MEMBER)
  region    String    @default("온라인")
  intro     String    @default("")
  hue       Int       @default(0)
  photoUrl  String?
  photoStatus PhotoStatus @default(NONE)

  createdAt DateTime  @default(now())
  bannedAt  DateTime?

  // 약속 이행 지표
  kept       Int @default(0)
  late       Int @default(0)
  cancelLate Int @default(0)
  noShow     Int @default(0)

  ratingSum   Int @default(0)
  reviewCount Int @default(0)

  listings        Listing[]
  bookingsAsMember Booking[] @relation("MemberBookings")
  bookingsAsHost   Booking[] @relation("HostBookings")
  messages        Message[]
  reviewsWritten  Review[]  @relation("ReviewAuthor")
  reviewsReceived Review[]  @relation("ReviewTarget")
  settlements     Settlement[]
  sessions        Session[]

  @@index([role])
  @@index([region])
}

/// 이용자 로그인 세션. 쿠키에는 이 토큰만 담긴다.
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Listing {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     ListingKind
  meetMode MeetMode

  title String
  body  String @db.Text

  /// 게임 키는 화면과 같은 소문자 값을 그대로 쓴다 ('lol', 'valorant' …)
  mainGame String
  games    String[]

  tier         String
  /// 0이면 무료
  pricePerHour Int    @default(0)

  region        String
  pcbang        String?
  availableFrom String
  availableTo   String

  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  bookings Booking[]

  @@index([active, region])
  @@index([active, kind])
  @@index([createdAt])
}

model Booking {
  id        String  @id
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// 신청한 사람
  memberId String
  member   User   @relation("MemberBookings", fields: [memberId], references: [id], onDelete: Cascade)

  /// 글을 올린 사람
  hostId String
  host   User   @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)

  startAt  DateTime
  hours    Int
  amount   Int
  meetMode MeetMode
  pcbang   String?

  status      BookingStatus @default(REQUESTED)
  checkInCode String
  createdAt   DateTime      @default(now())
  settled     Boolean       @default(false)

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  messages Message[]
  reviews  Review[]

  @@index([memberId, status])
  @@index([hostId, status])
  @@index([status, settled])
  @@index([startAt])
}

/// 앱 내 대화. 개인 연락처를 주고받지 않게 하려는 장치라 예약에 묶는다.
model Message {
  id        String  @id
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id        String  @id
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([targetId, createdAt])
}

model Settlement {
  id     String @id
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  gross  Int
  fee    Int
  net    Int
  status SettlementStatus @default(PENDING)

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  bookings Booking[]

  @@index([hostId, status])
}

model Plan {
  id       String     @id
  name     String
  target   PlanTarget
  /// 월 구독료. 0이면 무료
  monthly  Int        @default(0)
  /// 이 요금제에 적용할 중개 수수료율 (0~1)
  feeRate  Float      @default(0.15)
  features String[]
  active   Boolean    @default(true)
  note     String     @default("")
  sortOrder Int       @default(0)

  @@index([target])
}

/// 올라온 사진.
///
/// 파일로 두지 않고 DB 에 담는다. 파일로 두면 저장 경로·권한·배포 방식이
/// 하나만 어긋나도 사진이 조용히 사라지고, 올린 사람 브라우저에는 캐시가 남아
/// 있어서 본인만 멀쩡히 보인다. 그 상태는 알아채기가 아주 어렵다.
/// DB 에 담으면 백업(pg_dump)에도 같이 들어간다.
model Photo {
  /// 내용의 지문 + 확장자. 같은 사진은 같은 이름이 된다.
  id        String   @id
  mime      String
  data      Bytes
  bytes     Int
  createdAt DateTime @default(now())
}

/// 관리자 계정. 이용자와 완전히 분리된 로그인이다.
model AdminAccount {
  id       String @id
  username String @unique
  /// scrypt 해시. 원문 비밀번호는 어디에도 담지 않는다.
  passwordHash String
  name     String

  /// 최고 관리자는 삭제할 수 없다
  owner  Boolean @default(false)
  active Boolean @default(true)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions AdminSession[]
}

model AdminSession {
  token     String       @id
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}
