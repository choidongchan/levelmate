# ── 필수 ──────────────────────────────────────────────────────────
# Postgres 접속 주소. 서버에서는 deploy/setup.sh 가 만들어 넣는다.
DATABASE_URL="postgresql://hanpan:비밀번호@127.0.0.1:5432/hanpan?schema=public"

# ── 선택 ──────────────────────────────────────────────────────────
# 배포 도메인. 지정하지 않으면 https://www.levelmate.co.kr 로 동작한다.
# 미리보기 배포에서는 해당 URL을 넣어야 OG 태그·sitemap이 올바른 주소로 나온다.
NEXT_PUBLIC_SITE_URL=https://www.levelmate.co.kr

# 올라온 프로필 사진을 담을 폴더. 저장소 바깥에 두어야 배포해도 남는다.
# 비워두면 프로젝트 안의 .uploads 를 쓴다 (로컬 개발용).
UPLOAD_DIR=/opt/hanpan/uploads

# 라이엇 게임즈 API 키. developer.riotgames.com 에서 발급받는다.
# 이게 없으면 라이엇 계정 연결 기능만 조용히 쉬고, 나머지는 그대로 돈다.
# 개발용 키는 24시간마다 만료되니 실서비스에는 Personal/Production 키를 쓴다.
RIOT_API_KEY=

# 첫 실행 때 만들어질 관리자 계정. 비워두면 levelup / levelup 으로 만들어진다.
# 만들어진 뒤에는 이 값을 바꿔도 소용없다. 관리자 화면에서 바꿔야 한다.
# ADMIN_USERNAME=levelup
# ADMIN_PASSWORD=
